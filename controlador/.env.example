# Copia este archivo a ".env" y completa tus propios valores.
# NUNCA subas el archivo .env real a git (ya está en .gitignore).

PORT=8001

# --- Base de datos ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=libreta

# --- Auth (JWT simple, sin registro) ---
# Genera el hash con: npx ts-node scripts/hash-password.ts "tuPassword"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=4h
ADMIN_USER=admin

# Hash de "TestPassword" — coincide con REACT_APP_DEMO_USER/PASSWORD de
# vista/.env.example, así el login funciona de una vez sin pasos extra
# y la leyenda de credenciales en pantalla es verdad desde el arranque.
# Si cambias el password real, regenera el hash Y actualiza
# vista/.env.example para que la leyenda no quede desactualizada.
ADMIN_PASSWORD_HASH=$2b$10$r9r3ORrtp3LfhWaBcbB6Z.Z8weQ81a5KkciKsEBCDL1O1i84pdDw6

# --- Colección de Postman (testing manual) ---
# NO hace falta configurarla en local — se autodetecta bien con
# protocolo+host del propio request (queda http://localhost:8001).
#
# En el VPS SÍ es obligatoria: Nginx le quita el prefijo /proyectos/libreta
# antes de reenviar la petición a este backend (ver GUIA-DESPLIEGUE-VPS.md),
# así que el backend no tiene forma de reconstruirlo solo con los headers.
# PUBLIC_API_URL=https://dfpalacios.cloud/proyectos/libreta
