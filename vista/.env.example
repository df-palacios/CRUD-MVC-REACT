# Puerto de desarrollo. Fijo en 3001 (no 3000) porque el proyecto de la
# Rifa Navideña ya usa 3000 — así puedes correr las dos apps a la vez
# sin choques, para probar la integración con el portafolio en local.
PORT=3001

# Ya NO hace falta que pongas la IP del backend a mano: el frontend la
# detecta sola a partir de la URL con la que abriste la página (ver
# services/api.js). Deja esta variable comentada/borrada en el caso normal.
#
# Solo descoméntala si necesitas forzar una URL específica (por ejemplo,
# backend en un dominio distinto al del frontend en producción):
# REACT_APP_API_URL=http://localhost:8001

# URL del dashboard de testing: NO hace falta configurarla — por defecto
# es /docs en este mismo servidor (nunca un tercero). Solo descoméntala
# para forzar un valor específico:
# REACT_APP_TESTING_URL=https://tu-dominio.com/docs/

# URL del portafolio para el botón "Volver al portafolio": NO hace falta
# configurarla — se detecta sola (ver src/config/links.js). Solo
# descoméntala para forzar un valor específico:
# REACT_APP_PORTFOLIO_URL=http://localhost:5173

# --- Credenciales de demo (para mostrar en la pantalla de login) ---
# Esto es SOLO texto visible para quien entre a probar la app — no
# autentica nada por sí mismo, el login real sigue validando contra
# ADMIN_PASSWORD_HASH en controlador/.env. Si cambias el password real
# ahí, actualiza también estos dos valores para que la leyenda no mienta.
REACT_APP_DEMO_USER=admin
REACT_APP_DEMO_PASSWORD=Demo2026!
